{
  "name": "twl-monorepo",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "description": "A TailwindCSS utility library.",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "license": "MIT",
  "homepage": "https://github.com/Debbl/twl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git"
  },
  "bugs": "https://github.com/Debbl/twl/issues",
  "keywords": [
    "tailwindcss",
    "utility",
    "css"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "release": "bumpp -r && pnpm publish -r"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@debbl/eslint-config": "^3.17.3",
    "@types/node": "^25.9.5",
    "bumpp": "^10.4.1",
    "eslint": "9.39.2",
    "lint-staged": "^16.4.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.20.3",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
