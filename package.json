{
  "name": "twl-monorepo",
  "version": "0.2.0",
  "private": true,
  "description": "A TailwindCSS utility library.",
  "keywords": [
    "css",
    "tailwindcss",
    "utility"
  ],
  "homepage": "https://github.com/Debbl/twl#readme",
  "bugs": "https://github.com/Debbl/twl/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "spike": "pnpm --filter twl spike",
    "bench": "node ./scripts/bench-size.mjs",
    "play": "node ./scripts/play.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "bumpp -r && pnpm publish -r",
    "dev:website": "pnpm --filter @apps/website dev",
    "build:website": "pnpm --filter @apps/website build"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@debbl/oxc-config": "^0.0.5",
    "@types/node": "^25.9.5",
    "bumpp": "^10.4.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.20.3",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxlint --fix"
  },
  "packageManager": "pnpm@10.34.5"
}
