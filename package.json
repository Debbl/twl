{
  "name": "twl-monorepo",
  "version": "0.4.3",
  "private": true,
  "description": "A TailwindCSS utility library.",
  "keywords": [
    "css",
    "tailwindcss",
    "utility"
  ],
  "homepage": "https://github.com/Debbl/twl#readme",
  "bugs": "https://github.com/Debbl/twl/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo build --filter=./packages/*",
    "test": "turbo test --filter=./packages/* -- --run",
    "typecheck": "turbo typecheck --filter=./packages/*",
    "spike": "pnpm --filter twl spike",
    "bench": "node ./scripts/bench-size.mjs",
    "play": "node ./scripts/play.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "release": "bumpp -r",
    "dev:website": "pnpm --filter @apps/website dev",
    "build:website": "pnpm --filter @apps/website build"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@debbl/oxc-config": "^0.0.5",
    "@types/node": "^26.6.3",
    "bumpp": "^12.3.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.0",
    "turbo": "^2.11.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "oxlint --fix --no-error-on-unmatched-pattern"
  },
  "packageManager": "pnpm@10.34.5"
}
