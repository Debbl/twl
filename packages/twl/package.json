{
  "name": "twl",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "description": "",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "license": "MIT",
  "homepage": "https://github.com/Debbl/twl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git",
    "directory": "packages/twl"
  },
  "bugs": "https://github.com/Debbl/twl/issues",
  "keywords": [],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./macro": {
      "types": "./macro/index.d.ts",
      "default": "./macro/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "macro": [
        "./macro/index.d.ts"
      ],
      "*": [
        "./dist/*",
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "macro/"
  ],
  "scripts": {
    "dev": "pnpm build && node ./dist/index.cjs",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "babel-plugin-macros": "2 || 3",
    "babel-plugin-twl-macro": "*"
  },
  "peerDependenciesMeta": {
    "babel-plugin-macros": {
      "optional": true
    },
    "babel-plugin-twl-macro": {
      "optional": true
    }
  },
  "dependencies": {
    "cnfast": "^0.1.0"
  }
}
