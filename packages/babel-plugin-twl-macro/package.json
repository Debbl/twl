{
  "name": "babel-plugin-twl-macro",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "babel plugin for twl macro",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "license": "MIT",
  "homepage": "https://github.com/Debbl/twl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git",
    "directory": "packages/babel-plugin-twl-macro"
  },
  "bugs": "https://github.com/Debbl/twl/issues",
  "keywords": [],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./macro": {
      "import": {
        "types": "./dist/macro.d.mts",
        "default": "./dist/macro.mjs"
      },
      "require": {
        "types": "./dist/macro.d.cts",
        "default": "./dist/macro.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm build && node ./dist/index.cjs",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/helper-plugin-utils": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/traverse": "^7.29.8",
    "@babel/types": "^7.29.8",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-tester": "^12.0.0",
    "twl": "workspace:*"
  },
  "devDependencies": {
    "@types/babel-plugin-macros": "^3.1.3",
    "@types/babel__core": "^7.20.5",
    "@types/babel__helper-plugin-utils": "^7.10.3",
    "@types/babel__traverse": "^7.28.0"
  }
}
