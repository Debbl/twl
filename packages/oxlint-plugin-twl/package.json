{
  "name": "oxlint-plugin-twl",
  "version": "0.4.2",
  "description": "Oxlint JS plugin for twl class name templates: Tailwind class sorting within comment groups, and the compiler's constraints caught in the editor",
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "tailwindcss",
    "twl"
  ],
  "homepage": "https://github.com/Debbl/twl#readme",
  "bugs": "https://github.com/Debbl/twl/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git",
    "directory": "packages/oxlint-plugin-twl"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "eslint-plugin-twl": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.85.0"
  },
  "peerDependencies": {
    "@tailwindcss/node": ">=4",
    "oxlint": ">=1.85"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.34.5"
}
