{
  "name": "eslint-plugin-twl",
  "version": "0.4.3",
  "description": "ESLint rules for twl class name templates: Tailwind class sorting within comment groups, and the compiler's constraints caught in the editor",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "eslintplugin",
    "tailwindcss",
    "twl"
  ],
  "homepage": "https://github.com/Debbl/twl#readme",
  "bugs": "https://github.com/Debbl/twl/issues",
  "license": "MIT",
  "author": "Brendan Dash <me@aiwan.run> (https://aiwan.run)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debbl/twl.git",
    "directory": "packages/eslint-plugin-twl"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "synckit": "^0.11.13"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.3",
    "twl": "workspace:*"
  },
  "peerDependencies": {
    "@tailwindcss/node": ">=4",
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "@tailwindcss/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.34.5"
}
